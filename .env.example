# Required: Gemini API key (https://aistudio.google.com/apikey). GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=

# Required: Gemini model id (no default is built into the code), e.g. gemini-3.8-flash or gemini-3.5-flash-lite.
# Can also be given per run with --model.
GEMINI_MODEL=

# Optional
# GEMINI_THINKING_LEVEL=medium   # minimal | low | medium | high; not sent when unset (model default).
#                                # Supported levels differ per model (e.g. gemini-3.8-flash rejects minimal).
# AGENT_MAX_STEPS=45             # investigation turn budget
# AGENT_TIMEOUT=1800             # overall wall-clock budget in seconds
